  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "DBGTEST.BIN" CODE 24576
  25 CLS
  30 LET R=USR 24576
  40 IF R=254 THEN PRINT "THE FPGA HAS NO DEBUGGER"
  50 IF R=253 THEN PRINT "NO DEBUG MONITOR (/SYS/DEBUG.BIN)"
  60 IF R>=253 THEN STOP
  70 PRINT "BREAKS IN LAST TEST   ";PEEK 24580
  80 PRINT "INTERRUPTIONS (TEST 7) ";PEEK 24581+256*PEEK 24582
  85 IF PEEK 24583=0 THEN PRINT "TEST 8 SKIPPED (LOAD *FULLPAG)"
  90 PRINT
 100 IF R=0 THEN PRINT "OK"
 110 IF R>0 THEN PRINT "TEST ";R;" WRONG"
