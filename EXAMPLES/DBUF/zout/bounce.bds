758e 758e s ; -------------------------------------------------------------
758e 758e d dbaf
758e 758e u 02 01
758e 758e s waitvs: in a,(0afh)
7590 7590 d 0f
7590 7590 u 01 01
7590 7590 s         rrca
7591 7591 d 38fb
7591 7591 u 02 01
7591 7591 s         jr c,waitvs         ; si estamos dentro del vsync, esperar a salir
7593 7593 d dbaf
