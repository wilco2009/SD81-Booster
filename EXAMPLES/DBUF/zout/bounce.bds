7568 7568 u 03 01
7568 7568 s         ld (dbufst),a
756b 756b d 3e04
756b 756b u 02 01
756b 756b s         ld a,4              ; borde verde = dbuf ON (puerto ULA Spectrum)
756d 756d d d3fb
756d 756d u 02 01
756d 756d s         out (0fbh),a
756f 756f s 
756f 756f s ; -------------------------------------------------------------
756f 756f s ; Bucle principal: 1 iteracion por frame, sincronizada al VSYNC.
756f 756f s ; Con dbuf ON el hardware toma la instantanea al final del area
756f 756f s ; visible, mucho despues de que draw haya terminado -> sin cortes.
756f 756f s ; -------------------------------------------------------------
756f 756f d cd8e75
756f 756f u 03 01
756f 756f s main:   call waitvs         ; flanco de subida de VSYNC (blit ya terminado)
7572 7572 d cdaf75
7572 7572 u 03 01
7572 7572 s         call erase          ; borrar pelota (posicion actual)
7575 7575 d cd0376
7575 7575 u 03 01
7575 7575 s         call delay          ; ~6 ms de "trabajo": el haz entra en pantalla
7578 7578 d cdcd75
7578 7578 u 03 01
7578 7578 s         call move           ; nueva posicion con rebote
757b 757b d cdb375
757b 757b u 03 01
757b 757b s         call draw           ; dibujar pelota
757e 757e d cd0c76
757e 757e u 03 01
757e 757e s         call keys           ; SPACE conmuta dbuf; Z activo si Q pulsada
7581 7581 d 20ec
7581 7581 u 02 01
7581 7581 s         jr nz,main
7583 7583 s 
7583 7583 s ; --- salida: restaurar modos y volver a BASIC ---
7583 7583 d 3e55
7583 7583 u 02 01
7583 7583 s quit:   ld a,85
7585 7585 d 320908
7585 7585 u 03 01
7585 7585 s         ld (2057),a         ; doble buffer OFF
7588 7588 d 3e55
7588 7588 u 02 01
7588 7588 s         ld a,85
758a 758a d 32fd07
758a 758a u 03 01
758a 758a s         ld (2045),a         ; modo ZX81 normal
758d 758d d c9
758d 758d u 01 01
758d 758d s         ret
758e 758e s 
758e 758e s ; -------------------------------------------------------------
