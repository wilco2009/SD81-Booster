0000 0000 f bounce.asm
0000 0000 s ; =============================================================
0000 0000 s ; BOUNCE.ASM — demo del doble buffer del SD81 Booster (POKE 2057)
0000 0000 s ;
0000 0000 s ; Pelota (bloque 16x16) rebotando en modo Superfast HiRes Spectrum.
0000 0000 s ; En cada frame se BORRA la pelota, se pierde ~6 ms a proposito
0000 0000 s ; (simulando un dibujado pesado que cruza el barrido) y se REDIBUJA.
0000 0000 s ;
0000 0000 s ;   - Con doble buffer ON  (borde VERDE): imagen solida, sin parpadeo.
0000 0000 s ;   - Con doble buffer OFF (borde ROJO):  parpadeo intenso, porque el
0000 0000 s ;     haz pasa por la zona borrada antes del redibujado.
0000 0000 s ;
0000 0000 s ; Controles:  SPACE = conmutar doble buffer   M = congelar/mover   Q = salir
0000 0000 s ;
0000 0000 s ; Ensamblar con zmac (ver README.md). Carga desde BASIC:
0000 0000 s ;   10 FAST
0000 0000 s ;   20 LOAD FAST 'BOUNCE.BIN' CODE 30000
0000 0000 s ;   30 RAND USR 30000
0000 0000 s ;   40 SLOW
0000 0000 s ;
0000 0000 s ; Pantalla (HFILE) en $8000 (bloque 4). Front buffer en bloque 5:
0000 0000 s ;   POKE 2057,168+5 = 173  -> ON      POKE 2057,85 -> OFF
0000 0000 s ; =============================================================
0000 0000 s 
7530 7530 s         org 30000
7530 7530 s 
7530 7530 d f3
7530 7530 u 01 01
7530 7530 s start:  di
7531 7531 s         ; --- HFILE = $8000 ---
7531 7531 d 3e00
7531 7531 u 02 01
7531 7531 s         ld a,0
