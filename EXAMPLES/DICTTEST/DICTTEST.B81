  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "DICTTEST.BIN" CODE 24576
  30 PRINT "DICTIONARY LOOKUP TEST"
  40 FAST
  50 LET R=USR 24576
  60 SLOW
  70 IF R<>0 THEN PRINT "ERROR ";R;" (1=NO DICT.DIC)"
  80 IF R<>0 THEN STOP
  90 LET A=31744
 100 LET N=PEEK (A+11)+256*PEEK (A+12)+65536*PEEK (A+13)
 110 LET P=PEEK (A+9)+256*PEEK (A+10)
 120 LET T0=(PEEK (A+3)*60+PEEK (A+4))*100+PEEK (A+5)
 130 LET T1=(PEEK (A+6)*60+PEEK (A+7))*100+PEEK (A+8)
 140 LET T=T1-T0
 150 IF T<0 THEN LET T=T+360000
 160 PRINT "WORDS IN DICT: ";N
 170 PRINT "FOUND OK: ";PEEK (A+1);"/16"
 180 PRINT "ABSENT OK: ";PEEK (A+2);"/16"
 190 PRINT "STEPS: ";P
 200 PRINT "TIME (1/100 S): ";T
 210 PRINT "MS PER WORD: ";T*10/32
 220 PRINT "MS PER STEP: ";T*10/P
