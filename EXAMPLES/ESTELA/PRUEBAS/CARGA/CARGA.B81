  10 FAST
  20 LOAD THEN CLEAR 18431
  30 LOAD FAST "CARGA.BIN" CODE 18432
  40 LET R=USR 18432
  50 SLOW
  60 PRINT "ESTELA - PRUEBA A: CARGA"
  70 PRINT
  80 PRINT "RESULTADO: ";R
  90 PRINT "ERRORES DEL PATRON: ";PEEK 18434+256*PEEK 18435
 100 PRINT "RAMTOP: ";PEEK 16388+256*PEEK 16389
 110 PRINT "LIBRE DEBAJO DE 18432: ";18432-(PEEK 16404+256*PEEK 16405)
 120 IF R=0 THEN PRINT "BIEN"
 130 IF R<>0 THEN PRINT "MAL"
