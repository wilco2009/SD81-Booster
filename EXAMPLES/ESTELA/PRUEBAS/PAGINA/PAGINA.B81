  10 FAST
  20 LOAD THEN CLEAR 18431
  30 LOAD FAST "PAGINA.BIN" CODE 18432
  40 LET R=USR 18432
  50 SLOW
  60 PRINT "ESTELA - PRUEBA D: PAGINA"
  70 PRINT
  80 PRINT "RESULTADO: ";R
  90 PRINT "BYTES CAMBIADOS EN LA PAGINA 21: ";PEEK 18435+256*PEEK 18436
 100 IF R=0 THEN PRINT "BIEN"
 110 IF R<>0 THEN PRINT "MAL"
