; NIVEL1.LVL -- nivel de ejemplo de ESTELA (lo lee map2bin.py; formatos en claude/planning/juego160.md, seccion 8).
; Generado una vez por gennivel.py; a partir de aqui se edita a mano.
;
; El mapa (al final) tiene 8 tiles de ancho; la linea de ARRIBA es el final del nivel y la de ABAJO el principio.
; Reparto: filas 0-47 pradera, 48-95 rio (puente en la 70), 96-135 desierto, 136-187 canon de lava (puente en la 160),
;          188-241 base, 242-279 antesala del jefe y espacio. Cada fila de tiles son 16 pixeles de scroll.
;
; Regla de diseno (la comprueba map2bin --check): como mucho 3 enemigos de 16x16 cortan una misma linea de la zona.

include tiles.def
include paths.def

name NIVEL1
scroll 1


# --- pradera
wave pos=60    type=E1 x=48  path=SINE   count=4 spacing=16    ; cuatro platillos serpenteando
wave pos=r17   type=E6 x=40  path=STILL  count=1 flags=ground    ; tanque junto a la plataforma de la fila 14
wave pos=230   type=E2 x=24  path=DIVE   count=3 spacing=18    ; tres dardos en picado desde la izquierda
wave pos=r22   type=E6 x=88  path=STILL  count=1 flags=ground    ; tanque en la carretera
wave pos=420   type=E1 x=96  path=SINE   count=4 spacing=16 flags=mirror    ; platillos desde la derecha
wave pos=600   type=E3 x=32  path=ZIGZAG count=3 spacing=24    ; cangrejos en zigzag
wave pos=700   type=ITEM1 x=64 path=SLOW count=1    ; mejora de arma
wave pos=780   type=E2 x=40  path=DOWN   count=3 spacing=32 flags=row    ; fila de tres dardos

# --- rio
wave pos=960   type=E4 x=20  path=SWEEP  count=3 spacing=22    ; giratorios cruzando el rio
wave pos=1160  type=E4 x=130 path=SWEEP  count=3 spacing=22 flags=mirror    ; y desde el otro lado
wave pos=1340  type=E1 x=64  path=SINE   count=4 spacing=14
wave pos=1500  type=E5 x=48  path=HOVER  count=2 spacing=40 flags=row    ; dos bombarderos que se quedan disparando

# --- desierto
wave pos=1800  type=E3 x=96  path=ZIGZAG count=3 spacing=24 flags=mirror
wave pos=1980  type=E2 x=24  path=DIVE   count=3 spacing=18
wave pos=2150  type=E2 x=120 path=DIVE   count=3 spacing=18 flags=mirror
wave pos=2310  type=ITEM2 x=100 path=SLOW count=1    ; escudo
wave pos=2400  type=E5 x=56  path=HOVER  count=2 spacing=36 flags=row

# --- canon de lava
wave pos=2700  type=E4 x=20  path=SWEEP  count=3 spacing=22
wave pos=r172  type=E6 x=100 path=STILL  count=1 flags=ground    ; torreta en el borde del canon
wave pos=2880  type=E1 x=64  path=SINE   count=4 spacing=14
wave pos=3060  type=E3 x=40  path=ZIGZAG count=3 spacing=24

# --- base
wave pos=r198  type=E6 x=32  path=STILL  count=1 flags=ground    ; cañon en la plataforma
wave pos=3330  type=E5 x=40  path=HOVER  count=2 spacing=48 flags=row
wave pos=r209  type=E6 x=96  path=STILL  count=1 flags=ground
wave pos=3640  type=E2 x=24  path=DIVE   count=3 spacing=18
wave pos=3800  type=E2 x=120 path=DIVE   count=3 spacing=18 flags=mirror
wave pos=3980  type=ITEM3 x=80 path=SLOW count=1    ; bomba

# --- jefe
wave pos=4150  type=BOSS x=64 path=ENTER count=1    ; el jefe de 32x24 baja hasta y = 26 y se queda

map
  STARS   STARS   SPACE   STARS   SPACE   STARS   STARS   STARS    ; fila 279
  STARS   STARS   SPACE   SPACE   STARS   STARS   STARS   STARS    ; fila 278
