wave pos=r230    type=E6 x=48 path=STILL count=1 flags=ground    ; enemigo de suelo sobre PAD (fila 230)
wave pos=3676    type=E1 x=48 path=SINE count=4 spacing=14    ; platillos serpenteando
wave pos=r242    type=E6 x=96 path=STILL count=1 flags=ground    ; enemigo de suelo sobre PAD (fila 242)
wave pos=3865    type=E4 x=130 path=SWEEP count=3 spacing=22 flags=mirror    ; giratorios cruzando (espejo)
wave pos=r254    type=E6 x=48 path=STILL count=1 flags=ground    ; enemigo de suelo sobre PAD (fila 254)
