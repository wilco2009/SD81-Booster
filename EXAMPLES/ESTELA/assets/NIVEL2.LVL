; NIVEL2.LVL -- HIELO: tundra, lago helado, glaciar, canon criogenico, base y antesala del jefe (lo lee map2bin.py; formatos en claude/planning/juego160.md, seccion 8).
; Generado por genniveles.py; despues se puede editar a mano (genniveles.py lo sobrescribe si se vuelve a ejecutar).
;
; El mapa (al final) tiene 8 tiles de ancho; la linea de ARRIBA es el final del nivel y la de ABAJO el principio.
; 332 filas de 16 pixeles = 5312 pixeles de scroll; el jefe sale en la posicion 4982.
; Regla de diseno (la comprueba map2bin --check): como mucho 3 enemigos de 16x16 cortan una misma linea de la zona.

include tiles2.def
include paths.def

name NIVEL2
scroll 1

wave pos=70    type=E4 x=20 path=SWEEP count=3 spacing=22    ; giratorios cruzando
wave pos=r14    type=E6 x=80 path=STILL count=1 flags=ground    ; enemigo de suelo sobre SNOWTURRET (fila 14)
wave pos=240    type=E2 x=24 path=DIVE count=4 spacing=18    ; dardos en picado
wave pos=r30    type=E6 x=80 path=STILL count=1 flags=ground    ; enemigo de suelo sobre SNOWTURRET (fila 30)
wave pos=457    type=E3 x=96 path=ZIGZAG count=3 spacing=24 flags=mirror    ; cangrejos en zigzag (espejo)
wave pos=638    type=E4 x=130 path=SWEEP count=4 spacing=22 flags=mirror    ; giratorios cruzando (espejo)
wave pos=818    type=E5 x=32 path=HOVER count=2 spacing=40 flags=mirror,row    ; bombarderos que se quedan disparando (espejo)
