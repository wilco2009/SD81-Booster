  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "MOUSEBLE.BIN" CODE 24576
  30 CLS
  40 PRINT "1 EMPAREJAR  2 CONECTAR"
  50 PRINT "3 OLVIDAR    4 ACTIVAR"
  60 PRINT "5 PARAR      0 ESTADO"
  70 PRINT
  80 INPUT O
  90 IF O=0 THEN GOTO 160
 100 POKE 31755,O
 110 POKE 31756,0
 120 LET R=USR 24576
 130 IF R<>0 THEN PRINT "ORDEN NO VALIDA"
 140 PAUSE 100
 160 LET S=USR 24579
 170 PRINT AT 8,0;"CONECTADO  ";S-2*INT (S/2)
 180 PRINT "EMPAREJANDO ";INT (S/2)-2*INT (S/4);" ";PEEK 31758;"S  "
 190 PRINT "ACTIVADO   ";INT (S/4)-2*INT (S/8)
 200 PRINT "GUARDADO   ";INT (S/8)-2*INT (S/16)
 210 IF S<128 THEN PRINT "SIN MODULO WIFI"
 220 GOTO 80
