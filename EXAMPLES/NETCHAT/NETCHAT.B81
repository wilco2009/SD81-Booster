  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "NETCHAT.BIN" CODE 24576
  25 CLS
  30 PRINT "NETCHAT: INIT..."
  40 LET R=USR 24576
  50 IF R<>0 THEN GOTO 900
  60 PRINT "1=NEW ROOM  2=JOIN"
  70 INPUT K
  80 IF K=2 THEN GOTO 200
  90 PRINT "CREATING ROOM..."
 100 LET R=USR 24579
 110 IF R<>0 THEN GOTO 900
 120 PRINT "ROOM CODE:"
 130 FOR I=0 TO 9
 140 PRINT CHR$ PEEK (28680+I);
 150 NEXT I
 160 PRINT
 170 GOTO 300
 200 PRINT "ROOM CODE?"
 210 INPUT A$
 220 IF LEN A$<>10 THEN GOTO 200
 230 FOR I=0 TO 9
 240 POKE 28680+I,CODE A$(I+1)
 250 NEXT I
 260 LET R=USR 24582
 270 IF R<>0 THEN GOTO 900
 300 PRINT "S=SEND  Q=QUIT"
 310 LET T=0
 320 LET R=USR 24594
 322 PAUSE 25
 325 LET R=USR 24597
 330 IF R=1 THEN GOSUB 500
 340 IF R=2 THEN PRINT "* PEER IN"
 350 IF R=3 THEN PRINT "* PEER OUT"
 360 IF R=4 THEN PRINT "* MODEM ERROR"
 370 LET K$=INKEY$
 380 IF K$="S" THEN GOSUB 600
 390 IF K$="Q" THEN GOTO 800
 400 GOTO 320
 500 REM SHOW MESSAGE
 505 PRINT "< ";
 510 FOR I=0 TO PEEK 28677-1
 520 PRINT CHR$ PEEK (28816+I);
 530 NEXT I
 540 PRINT
 550 RETURN
 600 REM SEND
 605 PRINT "TEXT?"
 610 INPUT A$
 620 IF LEN A$>100 THEN LET A$=A$( TO 100)
 630 FOR I=1 TO LEN A$
 640 POKE 28703+I,CODE A$(I)
 650 NEXT I
 660 POKE 28677,LEN A$
 670 LET T=T+1
 675 IF T>255 THEN LET T=0
 680 POKE 28675,T
 690 LET R=USR 24585
 700 IF R<>0 THEN PRINT "SEND ERROR ";R
 705 IF R=0 THEN PRINT "> ";A$
 710 RETURN
 800 LET R=USR 24591
 810 STOP
 900 PRINT "ERROR ";R
