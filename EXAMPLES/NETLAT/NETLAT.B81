  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "NETLAT.BIN" CODE 24576
  30 CLS
  40 PRINT "NETLAT: INIT..."
  50 LET R=USR 24576
  60 IF R<>0 THEN GOTO 900
  70 PRINT "CONNECTING (UP TO 40 S)..."
  80 LET R=USR 24579
  90 IF R<>0 THEN PRINT "NO MQTT: ";R
 100 PRINT "MEASURING: SCREEN OFF 30 S"
 110 FAST
 120 LET R=USR 24582
 130 SLOW
 140 LET R=USR 24585
 150 CLS
 160 PRINT "NETLAT: N F AVG MIN-MAX MS"
 170 FOR T=0 TO 7
 180 LET A=31744+8*T
 190 LET N=PEEK A
 200 GOSUB 300+10*T
 210 IF N=0 THEN PRINT "  NO DATA  FAIL ";PEEK (A+7)
 220 IF N=0 THEN GOTO 260
 230 PRINT N;" F";PEEK (A+7);" A";INT (100*(PEEK (A+5)+256*PEEK (A+6))/N)/10;" ";10*(PEEK (A+1)+256*PEEK (A+2));"-";10*(PEEK (A+3)+256*PEEK (A+4))
 260 NEXT T
 270 PRINT "SEND ME THESE LINES"
 280 STOP
 300 PRINT "0 RTC READ"
 301 RETURN
 310 PRINT "1 100 NETREAD (PER 100)"
 311 RETURN
 320 PRINT "2 AT NO PAUSES"
 321 RETURN
 330 PRINT "3 AT WITH ATCMD POLL"
 331 RETURN
 340 PRINT "4 MQTT ECHO"
 341 RETURN
 350 PRINT "5 PUBLISH, WAIT >"
 351 RETURN
 360 PRINT "6 PUBLISH PIPELINED"
 361 RETURN
 370 PRINT "7 MQTT ECHO PIPELINED"
 371 RETURN
 900 PRINT "ERROR ";R
 910 STOP
