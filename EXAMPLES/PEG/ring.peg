; ARPEGGIO.PEG - 3-note arpeggio (C major approximation)
; Cycles through 3 notes at 60ms each, 8 cycles = 1.44 seconds
; Periods approx: 180 (A4), 144 (C#5), 120 (E5)
;
; Uses only tone channel C (R4/R5 period, R10 amplitude) — reserved for SFX
; by convention, so it doesn't collide with a VGM/PLAY track composed using
; channels A/B. Register R7 is the mixer, shared by all 3 channels — so
; instead of overwriting it wholesale, this effect reads it, flips only its
; own bit (channel C tone enable), and writes it back, leaving whatever
; A/B state the music track set untouched.
;
; NOTE: this only avoids stepping on channels A/B's ENABLE bit and tone/
; amplitude registers. It still assumes the VGM/PLAY track never uses
; channel C itself — if it does, the two will still collide on R4/R5/R10,
; the same way they did on channel A before. Pick whichever channel your
; music track actually leaves free.

        LD  V1, 0FBh    ; mask: clear bit2 (enable tone C), keep other bits
        LD  V0, R7      ; read current mixer state
        AND V0, V1
        LD  R7, V0      ; enable tone C without touching channels A/B/noise

        LD  R5, 0
        LD  R10, 12     ; amplitude
        LD  V2, 2       ; 8 arpeggio cycles

arp:
        LD  R4, 180     ; root note
        WAIT 60
        LD  R4, 144     ; third
        WAIT 60
        LD  R4, 120     ; fifth
        WAIT 60
        DJNZ V2, arp

        LD  R10, 0      ; silence channel C

        LD  V1, 04h     ; mask: set bit2 (disable tone C only)
        LD  V0, R7
        OR  V0, V1
        LD  R7, V0      ; restore mixer, leaving channels A/B/noise untouched

        HALT
