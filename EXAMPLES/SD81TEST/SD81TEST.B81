  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "SD81TEST.BIN" CODE 24576
  30 SLOW
 100 CLS
 110 PRINT "SD81 BOOSTER HARDWARE TEST"
 120 PRINT
 130 PRINT "1 MEMORY AND MAPPER"
 140 PRINT "2 EXECUTION (MC45)"
 150 PRINT "3 MEMORY-MAPPED PORTS"
 160 PRINT "4 MCU"
 170 PRINT "5 MACHINE INFO"
 180 PRINT "0 EXIT"
 190 LET N=5
 200 GOSUB 900
 210 IF K=0 THEN STOP
 220 LET R=100
 230 LET T=8
 240 IF K=5 THEN GOTO 800
 250 GOTO 200+100*K
 300 CLS
 310 PRINT "MEMORY AND MAPPER"
 320 PRINT
 330 PRINT "1 MEMORY TEST (DESTRUCTIVE)"
 340 PRINT "2 MAPPER STRESS"
 345 PRINT "3 UNPAGED MEMORY DETECT"
 350 PRINT "0 BACK"
 360 LET N=3
 370 GOSUB 900
 380 IF K=0 THEN GOTO 100
 390 LET R=300
 395 LET T=3*(K=2)+9*(K=3)
 399 GOTO 800
 400 CLS
 410 PRINT "EXECUTION (MC45)"
 420 PRINT
 430 PRINT "1 MC45 BLOCKS 4-5"
 440 PRINT "2 MC45 BLOCKS 6-7 (POKE 2062)"
 450 PRINT "0 BACK"
 460 LET N=2
 470 GOSUB 900
 480 IF K=0 THEN GOTO 100
 490 LET R=400
 495 LET T=K
 499 GOTO 800
 500 CLS
 510 PRINT "MEMORY-MAPPED PORTS"
 520 PRINT
 530 PRINT "1 POKE 2045 (SUPERFAST)"
 540 PRINT "2 SIMULATED INT (2038-2040)"
 550 PRINT "3 ROMLOCK"
 560 PRINT "0 BACK"
 570 LET N=3
 580 GOSUB 900
 590 IF K=0 THEN GOTO 100
 592 LET R=500
 595 LET T=K+3
 599 GOTO 800
 600 CLS
 610 PRINT "MCU"
 620 PRINT
 630 PRINT "1 PROTOCOL (SETBYTE/GETBYTE)"
 640 PRINT "0 BACK"
 650 LET N=1
 660 GOSUB 900
 670 IF K=0 THEN GOTO 100
 680 LET R=600
 690 LET T=7
 699 GOTO 800
 800 CLS
 810 LET E=USR (24576+3*T)
 820 IF INKEY$<>"" THEN GOTO 820
 830 PRINT AT 21,0;"ERRORS: ";E;" - PRESS A KEY"
 840 PAUSE 4E4
 850 IF INKEY$<>"" THEN GOTO 850
 860 GOTO R
 900 PRINT AT 21,0;"OPTION?"
 910 PAUSE 4E4
 920 LET K$=INKEY$
 930 IF K$<"0" OR K$>STR$ N THEN GOTO 910
 940 LET K=VAL K$
 950 IF INKEY$<>"" THEN GOTO 950
 960 RETURN
