  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "SD81TEST.BIN" CODE 24576
  30 SLOW
  40 CLS
  50 PRINT "SD81 BOOSTER HARDWARE TEST"
  60 PRINT
  70 PRINT "1 MEMORY"
  80 PRINT "2 MC45"
  90 PRINT "3 MC45 BLOCKS 6-7"
 100 PRINT "0 EXIT"
 110 PRINT
 120 PRINT "OPTION?"
 130 PAUSE 4E4
 140 LET K$=INKEY$
 150 IF K$="0" THEN STOP
 160 IF K$<"1" OR K$>"3" THEN GOTO 130
 170 CLS
 180 IF K$="1" THEN LET E=USR 24576
 190 IF K$="2" THEN LET E=USR 24579
 200 IF K$="3" THEN LET E=USR 24582
 210 IF INKEY$<>"" THEN GOTO 210
 220 PRINT AT 21,0;"ERRORS: ";E;" - PRESS A KEY"
 230 PAUSE 4E4
 240 GOTO 40
