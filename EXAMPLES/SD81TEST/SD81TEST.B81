  10 LOAD THEN CLEAR 20479
  20 LOAD FAST "SD81TEST.BIN" CODE 20480
  30 SLOW
  40 LET M$="1111101221112232213333330033333"
  50 LET L=0
 100 CLS
 110 PRINT "SD81 BOOSTER HARDWARE TEST"
 120 PRINT
 130 PRINT "1 MEMORY AND MAPPER"
 140 PRINT "2 EXECUTION (MC45)"
 150 PRINT "3 MEMORY-MAPPED PORTS"
 160 PRINT "4 MCU, RTC AND SD"
 170 PRINT "5 VIDEO"
 180 PRINT "6 SOUND"
 190 PRINT "7 INPUT (KEYBOARD, JOYSTICK)"
 192 PRINT "8 MACHINE INFO"
 195 PRINT "0 EXIT"
 200 LET N=8
 210 GOSUB 1100
 220 IF K=0 THEN STOP
 230 LET R=100
 240 LET T=8
 245 IF K=7 THEN LET T=22
 250 IF K>=7 THEN GOTO 1000
 260 GOTO 200+100*K
 300 CLS
 310 PRINT "MEMORY AND MAPPER"
 320 PRINT
 330 PRINT "1 MEMORY TEST (DESTRUCTIVE)"
 335 PRINT "2 MAPPER STRESS"
 340 PRINT "3 UNPAGED MEMORY DETECT"
 345 PRINT "4 MAPPER REGISTERS"
 350 PRINT "5 BLOCK 0 PROTECTION"
 352 PRINT "6 SYSTEM PAGES (0-3)"
 355 PRINT "0 BACK"
 360 LET N=6
 370 GOSUB 1100
 380 IF K=0 THEN GOTO 100
 390 LET R=300
 395 LET T=3*(K=2)+9*(K=3)+10*(K=4)+11*(K=5)+17*(K=6)
 399 GOTO 1000
 400 CLS
 410 PRINT "EXECUTION (MC45)"
 420 PRINT
 430 PRINT "1 MC45 BLOCKS 4-5"
 440 PRINT "2 MC45 BLOCKS 6-7 (POKE 2062)"
 450 PRINT "0 BACK"
 460 LET N=2
 470 GOSUB 1100
 480 IF K=0 THEN GOTO 100
 490 LET R=400
 495 LET T=K
 499 GOTO 1000
 500 CLS
 510 PRINT "MEMORY-MAPPED PORTS"
 520 PRINT
 530 PRINT "1 POKE 2045 (SUPERFAST)"
 540 PRINT "2 ROMLOCK"
 550 PRINT "3 SPRITES (VISUAL)"
 560 PRINT "0 BACK"
 570 LET N=3
 580 GOSUB 1100
 590 IF K=0 THEN GOTO 100
 592 LET R=500
 595 LET T=K+3+(K>1)+11*(K=3)
 599 GOTO 1000
 600 CLS
 610 PRINT "MCU, RTC AND SD"
 620 PRINT
 630 PRINT "1 PROTOCOL (SETBYTE/GETBYTE)"
 640 PRINT "2 RTC AND BATTERY"
 642 PRINT "3 SD READ (SDBOOST.ROM)"
 644 PRINT "4 SD WRITE (TEMP FILE)"
 650 PRINT "0 BACK"
 660 LET N=4
 670 GOSUB 1100
 680 IF K=0 THEN GOTO 100
 690 LET R=600
 695 LET T=7+6*(K=2)+8*(K=3)+9*(K=4)
 699 GOTO 1000
 700 CLS
 710 PRINT "VIDEO"
 720 PRINT
 730 PRINT "1 FRAME RATE (RTC REFERENCE)"
 732 PRINT "2 BORDER PATTERN (VISUAL)"
 734 PRINT "3 CHROMA81 MODE 0 (VISUAL)"
 735 PRINT "4 SUPERFAST MODES (VISUAL)"
 736 PRINT "5 CHARSETS 128/256 (VISUAL)"
 737 PRINT "6 70/80 COLUMNS (VISUAL)"
 738 PRINT "7 FINE SCROLL (VISUAL)"
 739 PRINT "8 CHROMA81 MODE 1 (VISUAL)"
 741 PRINT "9 DOUBLE BUFFER (VISUAL)"
 742 PRINT "0 BACK"
 750 LET N=9
 760 GOSUB 1100
 770 IF K=0 THEN GOTO 100
 780 LET R=700
 790 LET T=12+(K>1)*(K+5)+(K>4)*4
 799 GOTO 1000
 800 CLS
 810 PRINT "SOUND"
 820 PRINT
 830 PRINT "1 AY REGISTERS"
 835 PRINT "2 TONES AND SPEECH (AUDIO)"
 840 PRINT "0 BACK"
 850 LET N=2
 860 GOSUB 1100
 870 IF K=0 THEN GOTO 100
 880 LET R=800
 890 LET T=14+9*(K=2)
 899 GOTO 1000
1000 CLS
1002 LET F=VAL M$(T+1)
1004 IF F AND F<>L THEN GOSUB 1200+10*F
1010 LET E=USR (20480+3*T)
1030 PRINT AT 21,0;"ERRORS: ";E;" - PRESS A KEY"
1040 RAND USR 20555
1060 GOTO R
1100 PRINT AT 21,0;"OPTION?"
1120 LET K=USR 20552
1130 IF K>N THEN GOTO 1120
1160 RETURN
1210 LOAD FAST "SD81MEM.BIN" CODE 24576
1215 GOTO 1240
1220 LOAD FAST "SD81SYS.BIN" CODE 24576
1225 GOTO 1240
1230 LOAD FAST "SD81AV.BIN" CODE 24576
1240 LET L=F
1245 SLOW
1250 RETURN
