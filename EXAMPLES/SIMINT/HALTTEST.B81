  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "HALTTEST.BIN" CODE 24576
  25 CLS
  30 LET R=USR 24576
  40 IF R=2 THEN PRINT "THE FPGA HAS NO SIMULATED INTERRUPTS"
  50 IF R=2 THEN STOP
  60 PRINT "HALT AND DD HALT (100)"
  70 PRINT "RETURNS AFTER HALT    ";PEEK 24579+256*PEEK 24580
  80 PRINT "INTERRUPTIONS         ";PEEK 24581+256*PEEK 24582
 100 PRINT "FRAMES ELAPSED        ";PEEK 24583+256*PEEK 24584
 110 PRINT
 120 PRINT "CB 76, ED 76, DD CB D 76 (20000)"
 130 PRINT "INTERRUPTIONS         ";PEEK 24585+256*PEEK 24586
 150 PRINT "FRAMES ELAPSED        ";PEEK 24587+256*PEEK 24588
 160 PRINT
 170 IF R=0 THEN PRINT "OK"
 180 IF R=1 THEN PRINT "WRONG"
