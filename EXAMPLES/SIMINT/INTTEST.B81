  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "INTTEST.BIN" CODE 24576
  25 CLS
  30 LET R=USR 24576
  40 IF R=2 THEN PRINT "THE FPGA HAS NO M1 TRACKER"
  50 IF R=2 THEN STOP
  60 PRINT "CHECKSUM WITHOUT INTS ";PEEK 24579+256*PEEK 24580
  70 PRINT "CHECKSUM WITH INTS    ";PEEK 24581+256*PEEK 24582
  80 PRINT "INTERRUPTIONS (ISR)   ";PEEK 24583+256*PEEK 24584
  90 PRINT "INTERRUPTIONS (FPGA)  ";PEEK 24587+256*PEEK 24588
 100 PRINT "FRAMES ELAPSED        ";PEEK 24585+256*PEEK 24586
 110 PRINT
 120 IF R=0 THEN PRINT "OK"
 130 IF R=1 THEN PRINT "WRONG"
