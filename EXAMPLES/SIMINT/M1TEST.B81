  10 LOAD THEN CLEAR 24575
  20 LOAD FAST "M1TEST.BIN" CODE 24576
  30 LET R=USR 24576
  40 IF R=2 THEN PRINT "THE FPGA HAS NO M1 TRACKER"
  50 IF R=2 THEN STOP
  60 PRINT "M1 FETCHES   ";PEEK 24579+256*PEEK 24580;" (MUST BE 35)"
  70 PRINT "INSTRUCTIONS ";PEEK 24581+256*PEEK 24582;" (MUST BE 18)"
  80 PRINT "DD/FD CB     ";PEEK 24583+256*PEEK 24584;" (MUST BE 2)"
  90 PRINT "LAST OPCODE  ";PEEK 24585;"  STATE ";PEEK 24586
 100 PRINT
 110 IF R=0 THEN PRINT "OK"
 120 IF R=1 THEN PRINT "WRONG"
